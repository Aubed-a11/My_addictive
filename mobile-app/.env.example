# Adresse de base de l'API backend (gateway-service).
# IMPORTANT : le prefixe EXPO_PUBLIC_ est obligatoire (Expo SDK 49+) pour
# que cette variable soit reellement injectee dans le build web/natif -
# sans lui, elle est silencieusement ignoree et l'app retombe sur
# http://localhost:8090.
#
# En developpement local (meme reseau Wi-Fi que le backend) :
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.X:8090
# En production (backend deploye sur le VPS, voir DEPLOIEMENT.md) :
#   EXPO_PUBLIC_API_BASE_URL=https://votre-domaine.com/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:8090
