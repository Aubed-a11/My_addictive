# Copier ce fichier en .env (facultatif) pour personnaliser le backend.
# Le script de demarrage (demarrer-backend.ps1 / demarrer-backend.sh) lit ce
# fichier et exporte ces variables dans l'environnement avant de lancer les
# services Java, exactement comme le faisait auparavant docker-compose.

# JWT (signature HS256 partagee entre compte-service et gateway-service)
JWT_SECRET=change_moi_en_prod_avec_une_longue_chaine_aleatoire

# Mobile money (laisser vide = mode simulation avec confirmation automatique des paiements, pratique en developpement)
MTN_MOMO_BASE_URL=
MTN_MOMO_API_KEY=
MOOV_MONEY_BASE_URL=
MOOV_MONEY_API_KEY=

# Compte administrateur (back-office), cree automatiquement au premier demarrage de compte-service.
# A CHANGER avant toute mise en ligne reelle.
ADMIN_EMAIL=admin@myaddictive.com
ADMIN_MOT_DE_PASSE=AdminAddictive2026!
