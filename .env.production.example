# Copier ce fichier vers .env.production et remplir les vraies valeurs avant
# de lancer deployer.sh. NE JAMAIS committer .env.production (il contient de
# vrais secrets) : voir .gitignore.

# Domaine pointant vers ce VPS (configure chez Infomaniak/votre registrar en
# enregistrement DNS de type A vers l'IP du VPS). Optionnel pour demarrer :
# laisser vide ou mettre l'IP du VPS si tu n'as pas encore de domaine (voir
# "Demarrage rapide sans domaine" dans DEPLOIEMENT.md).
DOMAINE=votre-domaine.com

# Adresse publique complete de l'API, telle qu'appelee par le navigateur
# depuis le dashboard admin (sans slash final).
# Avec domaine + HTTPS : https://votre-domaine.com/api
# Sans domaine (IP seule, pas de HTTPS possible) : http://IP_DU_VPS/api
URL_PUBLIQUE_API=https://votre-domaine.com/api

# Secret utilise pour signer les jetons JWT. CRITIQUE : genere une vraie
# valeur aleatoire longue avant le premier deploiement (ex. commande
# `openssl rand -base64 48`), et ne la change plus ensuite (ca deconnecterait
# tous les utilisateurs). Ne JAMAIS garder la valeur par defaut de
# developpement.
JWT_SECRET=

# Identifiants du compte administrateur cree automatiquement au premier
# demarrage de compte-service.
ADMIN_EMAIL=admin@myaddictive.com
ADMIN_MOT_DE_PASSE=

# Agregateurs de paiement mobile money (laisser MTN_MOMO_SUBSCRIPTION_KEY /
# MTN_MOMO_API_USER / MTN_MOMO_API_KEY vides pour rester en mode simulation -
# voir la section "3bis. Activer les vrais paiements MTN Mobile Money" de
# DEPLOIEMENT.md pour la procedure complete d'obtention de ces identifiants).
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_HOST=
MOOV_MONEY_API_KEY=
